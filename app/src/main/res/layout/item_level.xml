<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:background="@drawable/bg_level_unlocked"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/levelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/levelChapter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#CCFFFFFF"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/levelStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/levelStar1"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:tint="@color/star_empty" />

        <ImageView
            android:id="@+id/levelStar2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:tint="@color/star_empty" />

        <ImageView
            android:id="@+id/levelStar3"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_star"
            app:tint="@color/star_empty" />
    </LinearLayout>
</LinearLayout>
